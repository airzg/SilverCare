.book { padding: 28rpx 32rpx 60rpx; }
.hospital { display: flex; align-items: center; }
.hospital-icon { width: 72rpx; height: 72rpx; border-radius: 18rpx; background: #eef3ff; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; }
.hospital-info { flex: 1; }
.small { font-size: 24rpx; margin-top: 4rpx; }

.date-row { display: flex; gap: 16rpx; }
.date-chip {
  flex: 1; min-width: 0; background: #fff; border: 2rpx solid #edf0f6;
  border-radius: 18rpx; padding: 20rpx 0; text-align: center;
}
.date-chip.selected { border-color: #4f7cff; background: #eef3ff; }
.date-chip.cal { flex: 0 0 100rpx; display: flex; align-items: center; justify-content: center; }
.date-day { font-size: 26rpx; font-weight: 600; }
.date-label { font-size: 22rpx; color: #8b93a7; margin-top: 6rpx; }
.date-chip.selected .date-day, .date-chip.selected .date-label { color: #4f7cff; }

.time-row { display: flex; gap: 16rpx; }
.time-chip { flex: 1; background: #fff; border: 2rpx solid #edf0f6; border-radius: 18rpx; padding: 20rpx 12rpx; text-align: center; }
.time-chip.selected { border-color: #4f7cff; background: #eef3ff; }
.time-name { font-size: 26rpx; font-weight: 600; }
.time-range { font-size: 20rpx; color: #8b93a7; margin-top: 6rpx; }
.time-chip.selected .time-name, .time-chip.selected .time-range { color: #4f7cff; }

.service { display: flex; align-items: center; }
.service-icon { width: 64rpx; height: 64rpx; border-radius: 16rpx; background: #eef3ff; display: flex; align-items: center; justify-content: center; margin-right: 18rpx; }
.service-info { flex: 1; }

.includes { padding: 24rpx 28rpx; }
.include-item { display: flex; align-items: center; font-size: 26rpx; color: #5b6479; padding: 12rpx 0; }
.include-item van-icon { margin-right: 14rpx; }

.price-row { text-align: center; margin: 44rpx 0 24rpx; }
.price { font-size: 44rpx; font-weight: 700; color: #ef5b5b; }
.confirm { margin-top: 10rpx; }
