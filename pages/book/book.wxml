<view class="page book">
  <picker mode="selector" range="{{hospitals}}" range-key="name" value="{{hospitalIndex}}" bindchange="onHospital">
    <view class="hospital card">
      <view class="hospital-icon"><van-icon name="location-o" size="44rpx" color="#4f7cff" /></view>
      <view class="hospital-info">
        <view class="strong">{{hospital.name}}</view>
        <view class="muted small">{{hospital.address}}</view>
        <view class="muted small">{{hospital.detail}}</view>
      </view>
      <van-icon name="arrow" color="#c2c8d6" />
    </view>
  </picker>

  <view class="section-title">Select a date</view>
  <view class="date-row">
    <view wx:for="{{dates}}" wx:key="key" class="date-chip {{item.key === date ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="onDate">
      <view class="date-day">{{item.day}}</view>
      <view class="date-label">{{item.date}}</view>
    </view>
    <picker class="date-chip cal" mode="date" value="{{date}}" start="{{minDate}}" end="{{maxDate}}" bindchange="onCalendar">
      <van-icon name="calendar-o" size="40rpx" color="#4f7cff" />
    </picker>
  </view>

  <view class="section-title">Select a time</view>
  <view class="time-row">
    <view wx:for="{{times}}" wx:key="key" class="time-chip {{item.key === time ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="onTime">
      <view class="time-name">{{item.name}}</view>
      <view class="time-range">{{item.range}}</view>
    </view>
  </view>

  <view class="section-title">Type of service</view>
  <view class="service card" bindtap="onService">
    <view class="service-icon"><van-icon name="plus" size="40rpx" color="#4f7cff" /></view>
    <view class="service-info">
      <view class="strong">{{service.name}}</view>
      <view class="muted small">RMB {{service.price}} / {{service.duration}}</view>
    </view>
    <van-icon name="arrow" color="#c2c8d6" />
  </view>

  <view class="section-title">What is included</view>
  <view class="includes card">
    <view class="include-item" wx:for="{{includes}}" wx:key="*this"><van-icon name="checked" size="32rpx" color="#1cb894" /> <text>{{item}}</text></view>
  </view>

  <view class="price-row">
    <text class="price">RMB {{service.price}}</text>
    <text class="muted">/ {{service.duration}}</text>
  </view>
  <button class="brand-btn blue confirm" bindtap="onConfirm">Confirm booking</button>
</view>
