<view class="page report">
  <view class="report-head">
    <view class="rh-title">Service report</view>
    <view class="rh-sub">Visit summary generated</view>
  </view>

  <view class="report-body">
    <view class="keypoints"><van-icon name="info-o" size="32rpx" /> 3 key points · sheet photographed</view>

    <view class="sheet">
      <van-icon name="photo-o" size="64rpx" color="#c2c8d6" />
      <view class="muted">Large-print sheet · image</view>
    </view>

    <view class="summary">
      <view class="sum-item"><van-icon name="checked" size="30rpx" color="#1cb894" /> Registration and consultation recorded</view>
      <view class="sum-item"><van-icon name="checked" size="30rpx" color="#1cb894" /> Pharmacy collected, with photo of original sheet</view>
      <view class="sum-item"><van-icon name="checked" size="30rpx" color="#1cb894" /> Advice sheet handed over and explained</view>
    </view>

    <view class="next-visit">Next visit · 2 June</view>

    <view class="sign-row">
      <view class="sign-box">
        <view class="muted small">Consent</view>
        <view class="signed">Signed ✓</view>
      </view>
      <view class="sign-box">
        <view class="muted small">Records bond</view>
        <view class="signed">24 hours left</view>
      </view>
    </view>

    <view class="report-actions">
      <button class="brand-btn ghost" bindtap="onReview">Review</button>
      <button class="brand-btn blue" bindtap="onShare">Share with family</button>
    </view>

    <view class="report-foot row between">
      <text class="muted">Order CN-2026-0418</text>
      <text class="filed">Filed ✓</text>
    </view>
  </view>
</view>
