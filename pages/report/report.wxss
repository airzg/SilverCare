.report { background: #f6f8fc; }
.report-head { background: #2f6fe4; color: #fff; padding: 40rpx 40rpx 120rpx; }
.rh-title { font-size: 40rpx; font-weight: 700; }
.rh-sub { font-size: 24rpx; opacity: .85; margin-top: 10rpx; }
.report-body { padding: 0 28rpx 60rpx; margin-top: -80rpx; }

.keypoints {
  background: #fff5e6; color: #a86b17; border-radius: 16rpx;
  padding: 22rpx 24rpx; font-size: 26rpx; display: flex; align-items: center;
}
.keypoints van-icon { margin-right: 12rpx; }

.sheet {
  background: #fff; border: 2rpx dashed #d6dced; border-radius: 20rpx;
  height: 260rpx; margin-top: 24rpx; display: flex; flex-direction: column;
  align-items: center; justify-content: center; color: #c2c8d6; font-size: 24rpx; gap: 14rpx;
}

.summary { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-top: 24rpx; }
.sum-item { display: flex; align-items: flex-start; font-size: 26rpx; color: #5b6479; line-height: 1.6; padding: 10rpx 0; }
.sum-item van-icon { margin-right: 12rpx; flex-shrink: 0; margin-top: 4rpx; }

.next-visit { background: #e6f8f2; color: #128766; border-radius: 16rpx; padding: 22rpx 24rpx; font-size: 28rpx; font-weight: 600; margin-top: 24rpx; }

.sign-row { display: flex; gap: 20rpx; margin-top: 24rpx; }
.sign-box { flex: 1; background: #fff; border-radius: 18rpx; padding: 24rpx; }
.small { font-size: 22rpx; }
.signed { font-size: 28rpx; font-weight: 600; margin-top: 10rpx; color: #1cb894; }

.report-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.report-actions .brand-btn { flex: 1; }
.report-foot { margin-top: 32rpx; font-size: 22rpx; }
.filed { color: #1cb894; }
