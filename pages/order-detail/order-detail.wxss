.detail { padding: 32rpx 32rpx 60rpx; }

.page-title { font-size: 36rpx; font-weight: 700; margin: 0 0 28rpx; }

.companion { display: flex; align-items: center; }
.avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: #eef3ff; color: #4f7cff;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700; margin-right: 20rpx;
}
.companion-info { flex: 1; }
.name-row { display: flex; align-items: center; }
.name { font-size: 30rpx; font-weight: 600; }
.badge {
  font-size: 20rpx; color: #1cb894; background: #e6f8f2;
  padding: 4rpx 12rpx; border-radius: 16rpx; margin-left: 12rpx;
}
.rating, .traits { font-size: 22rpx; color: #8b93a7; margin-top: 6rpx; }

.timeline { margin-top: 24rpx; padding: 28rpx 28rpx 8rpx; }
.step { display: flex; }
.rail { width: 48rpx; display: flex; flex-direction: column; align-items: center; }
.dot {
  width: 32rpx; height: 32rpx; border-radius: 50%;
  background: #d8dde8; display: flex; align-items: center; justify-content: center;
}
.dot.done { background: #1cb894; }
.dot.active { background: #4f7cff; box-shadow: 0 0 0 6rpx rgba(79,124,255,.15); }
.active-core { width: 12rpx; height: 12rpx; border-radius: 50%; background: #fff; }
.line { flex: 1; width: 4rpx; background: #edf0f6; margin: 6rpx 0; }
.step-body { flex: 1; padding: 0 0 28rpx 12rpx; }
.step-title { font-size: 28rpx; font-weight: 600; color: #8b93a7; }
.step-title.done { color: #1a2240; }
.step-title.active { color: #4f7cff; }
.step-desc { font-size: 22rpx; color: #8b93a7; margin-top: 6rpx; }

.info-card, .call-card, .next { margin-top: 24rpx; padding: 28rpx; }
.call-card { display: flex; align-items: center; }
.call-text { flex: 1; margin-left: 16rpx; color: #4f7cff; font-size: 26rpx; }
.section-label { font-size: 24rpx; font-weight: 600; margin-bottom: 12rpx; }
.next-item { font-size: 24rpx; color: #5b6479; padding: 8rpx 0; }
.notify { margin-top: 40rpx; }
