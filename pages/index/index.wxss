.home { padding-bottom: 160rpx; background: #fff; }

.hero {
  background: #fff;
  padding: 28rpx 36rpx 24rpx;
  color: var(--ink);
}
.hero-top { display: flex; align-items: center; }
.avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: #e3ecff; color: var(--brand-blue); font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; margin-right: 20rpx;
}
.hero-greet { flex: 1; }
.hello { font-size: 38rpx; font-weight: 700; color: var(--ink); }
.hello-sub { font-size: 24rpx; color: var(--muted); margin-top: 6rpx; }

.hero-photo { width: 100%; height: 340rpx; overflow: hidden; }
.hero-photo image { width: 100%; height: 100%; display: block; }

.actions { padding: 40rpx 36rpx; }
.action { justify-content: flex-start; margin-bottom: 24rpx; padding: 0 32rpx; width: 100% !important; }
.action-label { flex: 1; text-align: left; margin-left: 20rpx; }

.tabbar {
  position: fixed; left: 0; right: 0; bottom: 0; height: 110rpx;
  background: #fff; display: flex; border-top: 1rpx solid var(--line);
  padding-bottom: env(safe-area-inset-bottom);
}
.tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--muted); font-size: 22rpx; }
.tab text { margin-top: 6rpx; }
.tab.active { color: var(--brand-blue); }
