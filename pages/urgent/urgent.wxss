.urgent { display: flex; flex-direction: column; height: 100vh; padding-bottom: 0; }
.top-title { font-size: 40rpx; font-weight: 700; padding: 32rpx 32rpx 8rpx; color: #ef5b5b; }
.top-sub { font-size: 24rpx; padding: 0 32rpx 24rpx; }

.chat { flex: 1; overflow-y: auto; padding: 20rpx 32rpx; }
.msg { display: flex; align-items: flex-start; margin-bottom: 28rpx; }
.msg.me { justify-content: flex-end; }
.avatar { width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff; margin-right: 16rpx; }
.avatar.cs { background: #ef5b5b; }
.bubble {
  max-width: 74%; background: #fff; border-radius: 8rpx 24rpx 24rpx 24rpx;
  padding: 22rpx 26rpx; font-size: 28rpx; line-height: 1.6; color: #1a2240;
  box-shadow: 0 4rpx 16rpx rgba(26,34,64,.05);
}
.msg.me .bubble { background: #4f7cff; color: #fff; border-radius: 24rpx 8rpx 24rpx 24rpx; }

.composer {
  display: flex; align-items: center; gap: 16rpx; padding: 20rpx 24rpx;
  border-top: 1rpx solid #edf0f6; background: #fff;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.composer-input {
  flex: 1; height: 80rpx; background: #f6f8fc; border-radius: 40rpx;
  padding: 0 30rpx; font-size: 28rpx;
}
.send-btn {
  width: 130rpx; height: 80rpx; line-height: 80rpx; border-radius: 40rpx;
  background: #ef5b5b; color: #fff; font-size: 28rpx; padding: 0; border: none;
}
.send-btn::after { border: none; }
