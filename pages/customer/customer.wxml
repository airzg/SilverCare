<view class="page customer">
  <view class="hero">
    <view class="hero-top">
      <view class="avatar">LX</view>
      <view class="hero-greet">
        <view class="hello">Hello, Mrs. Wang</view>
        <view class="hello-sub">Care with past 3 visits</view>
      </view>
      <van-icon name="setting-o" size="44rpx" color="#fff" bindtap="onSetting" />
    </view>
    <view class="hero-illustration">
      <view class="illus-circle c1"></view>
      <view class="illus-circle c2"></view>
      <view class="illus-heart">♥</view>
      <view class="illus-caption">A hospital companion service for older adults</view>
    </view>
  </view>

  <view class="actions">
    <button class="brand-btn blue action" bindtap="goBook">
      <van-icon name="calendar-o" size="40rpx" /> <text class="action-label">Book a visit</text> <van-icon name="arrow" />
    </button>
    <button class="brand-btn green action" bindtap="goOrders">
      <van-icon name="orders-o" size="40rpx" /> <text class="action-label">My orders</text> <van-icon name="arrow" />
    </button>
    <button class="brand-btn orange action" bindtap="goReport">
      <van-icon name="description-o" size="40rpx" /> <text class="action-label">Service report</text> <van-icon name="arrow" />
    </button>
    <button class="brand-btn red action" bindtap="goUrgent">
      <van-icon name="warning-o" size="40rpx" /> <text class="action-label">Urgent help</text> <van-icon name="arrow" />
    </button>
  </view>
</view>
