<view class="page customer">
  <view class="hero">
    <view class="hero-top">
      <view class="avatar">LX</view>
      <view class="hero-greet">
        <view class="hello">Hello Mrs Wang</view>
        <view class="hello-sub">Care with past 3 visits</view>
      </view>
      <van-icon name="setting-o" size="44rpx" color="#fff" bindtap="onSetting" />
    </view>
    <view class="hero-stats">
      <view class="stat" data-filter="Completed" bindtap="goOrdersWithFilter" hover-class="stat-hover">
        <view class="stat-value">{{completedCount}}</view>
        <view class="stat-label">Completed</view>
      </view>
      <view class="stat" data-filter="Upcoming" bindtap="goOrdersWithFilter" hover-class="stat-hover">
        <view class="stat-value">{{upcomingCount}}</view>
        <view class="stat-label">Upcoming</view>
      </view>
      <view class="stat">
        <view class="stat-value">92</view>
        <view class="stat-label">Satisfaction score</view>
      </view>
    </view>
  </view>

  <view class="section-title">Account</view>
  <van-cell-group custom-class="profile-group">
    <van-cell title="Personal information" label="Name phone and address" icon="contact" is-link data-title="Personal information" bind:click="onAccountTap" />
    <van-cell title="Emergency contact" label="Who to call in an emergency" icon="phone-o" is-link data-title="Emergency contact" bind:click="onAccountTap" />
    <van-cell title="Care preferences" label="Language mobility and notes" icon="like-o" is-link data-title="Care preferences" bind:click="onAccountTap" />
  </van-cell-group>

  <view class="section-title">Records</view>
  <van-cell-group custom-class="profile-group">
    <van-cell title="Visit history" label="Past and upcoming bookings" icon="orders-o" is-link data-title="Visit history" bind:click="onAccountTap" />
    <van-cell title="Service reports" label="Reports from completed visits" icon="description" is-link bind:click="goReport" />
  </van-cell-group>

  <view class="section-title">Support</view>
  <van-cell-group custom-class="profile-group">
    <van-cell title="Notifications" icon="bell" is-link data-title="Notifications" bind:click="onAccountTap" />
    <van-cell title="Help and support" icon="question-o" is-link data-title="Help and support" bind:click="onAccountTap" />
    <van-cell title="About SilverCare" icon="info-o" is-link data-title="About SilverCare" bind:click="onAccountTap" />
  </van-cell-group>
</view>
