.hero {
  background: linear-gradient(135deg, #6a93ff 0%, #9db8ff 55%, #bcd0ff 100%);
  padding: 40rpx 36rpx 36rpx;
  border-radius: 0 0 40rpx 40rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}
.hero-top { display: flex; align-items: center; position: relative; z-index: 2; }
.avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: #fff; color: #6a93ff; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; margin-right: 20rpx;
}
.hero-greet { flex: 1; }
.hello { font-size: 36rpx; font-weight: 700; }
.hello-sub { font-size: 24rpx; opacity: .9; margin-top: 6rpx; }

.hero-stats {
  display: flex;
  margin-top: 36rpx;
  position: relative;
  z-index: 2;
}
.stat {
  flex: 1;
  text-align: center;
  border-right: 2rpx solid rgba(255,255,255,.25);
}
.stat:last-child { border-right: none; }
.stat-hover { opacity: .7; }
.stat-value { font-size: 40rpx; font-weight: 700; }
.stat-label { font-size: 22rpx; opacity: .85; margin-top: 6rpx; }

.section-title {
  margin-left: 24rpx;
  margin-right: 24rpx;
}

.profile-group {
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(26,34,64,.06);
}
