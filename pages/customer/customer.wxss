.home { padding-bottom: 160rpx; }

.hero {
  background: linear-gradient(135deg, #6a93ff 0%, #9db8ff 55%, #bcd0ff 100%);
  padding: 40rpx 36rpx 30rpx;
  border-radius: 0 0 40rpx 40rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}
.hero-top { display: flex; align-items: center; position: relative; z-index: 2; }
.avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: #fff; color: #6a93ff; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; margin-right: 20rpx;
}
.hero-greet { flex: 1; }
.hello { font-size: 36rpx; font-weight: 700; }
.hello-sub { font-size: 24rpx; opacity: .9; margin-top: 6rpx; }

.hero-illustration {
  margin-top: 30rpx; height: 260rpx; position: relative; z-index: 1;
  display: flex; align-items: center; justify-content: center;
}
.illus-circle { position: absolute; border-radius: 50%; background: rgba(255,255,255,.22); }
.c1 { width: 300rpx; height: 300rpx; right: -40rpx; top: -40rpx; }
.c2 { width: 200rpx; height: 200rpx; left: 20rpx; bottom: -60rpx; background: rgba(255,255,255,.14); }
.illus-heart { font-size: 100rpx; color: rgba(255,255,255,.85); z-index: 2; }
.illus-caption {
  position: absolute; bottom: 8rpx; font-size: 22rpx; opacity: .85; z-index: 2;
  text-align: center; width: 100%;
}

.actions { padding: 40rpx 0 0; }
.action { justify-content: flex-start; margin-bottom: 24rpx; padding: 0 32rpx; width: 100%; }
.action-label { flex: 1; text-align: left; margin-left: 20rpx; }

.tabbar {
  position: fixed; left: 0; right: 0; bottom: 0; height: 110rpx;
  background: #fff; display: flex; border-top: 1rpx solid #edf0f6;
  padding-bottom: env(safe-area-inset-bottom);
}
.tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #9aa3b5; font-size: 22rpx; }
.tab text { margin-top: 6rpx; }
.tab.active { color: #4f7cff; }
